doctype html
html
  head
    title= `${title}`
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 HubSpot CRM Records
    p
      a(href="/update-cobj") + Add New Record
    table(border="1", cellpadding="8", cellspacing="0")
      thead
        tr
          th ID
          th First Name
          th Last Name
          th Email
          th Actions
      tbody
        if records && records.length
          each record in records
            tr
              td= record.id
              td= record.properties.firstname || '—'
              td= record.properties.lastname || '—'
              td= record.properties.email || '—'
              td
                a(href=`/edit/${record.id}`) Edit
                |  | 
                a(href=`/delete/${record.id}`, onclick="return confirm('Are you sure you want to delete this record?');") Delete
        else
          tr
            td(colspan="5") No records found.
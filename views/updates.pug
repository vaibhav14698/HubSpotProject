doctype html
html
  head
    title= `${title}`
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    .form-wrapper
      h1= record ? 'Edit Record' : 'Add CRM Record'
      p
        a(href="/") Return to homepage

      form(method="POST", action="/update-cobj")
        //- Hidden ID determines whether this request creates or patches
        if record
          input(type="hidden", name="id", value=record.id)

        div(style="margin-bottom: 12px;")
          label(for="firstname") First Name:
          br
          input(type="text", name="firstname", id="firstname", value=(record && record.properties ? record.properties.firstname : ''), required)

        div(style="margin-bottom: 12px;")
          label(for="lastname") Last Name:
          br
          input(type="text", name="lastname", id="lastname", value=(record && record.properties ? record.properties.lastname : ''), required)

        div(style="margin-bottom: 12px;")
          label(for="email") Email:
          br
          input(type="email", name="email", id="email", value=(record && record.properties ? record.properties.email : ''), required)

        div
          input(type="submit", value=record ? "Update Record" : "Create Record")